@model Bookshelf.ViewModels.CreateBookViewModel
@{
    ViewData["Title"] = "AddBook";
}

<form method="post">
    <div asp-validation-summary="All"></div>

    <div>
        <label asp-for="Title"> Title: </label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>

   <div>
        <label asp-for="AuthorID">Author:</label>
        <select asp-for="AuthorID"
                class="form-control">
                <option value="">Select Author</option>
                @foreach (var author in Model.ExistingAuthors)
                    {
                        <option value="@author.Id">@author.Name, @author.Birthdate  </option>
                    }
        <span asp-validation-for="AuthorID"></span>
        </select>
        
     </div>

     <div>
         <label asp-for="SelectedGenres"> Genre:</label>
         <select asp-for="SelectedGenres"
         multiple class="form-select">
             <option value="">Select Genre</option>
            @foreach (BookshelfBL.Genre genre in Enum.GetValues(typeof(BookshelfBL.Genre)))
                    {
                <option value="@((int)genre)">@genre</option>
                    }
                </select>
     </div>
