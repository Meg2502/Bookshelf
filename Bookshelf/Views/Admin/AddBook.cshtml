        <label asp-for="SelectedGenres"> Genre:</label>
        <select asp-for="SelectedGenres"
                asp-items="Html.GetEnumSelectList<BookshelfBL.Genre>()"
                    multiple
                    class="form-select">
        </select> 
    *@ 
    
    <div>
        <label asp-for="Description" >Description: </label>
        <input asp-for="Description" />
        
    </div>

    <div>
        <label asp-for="ReleaseDate" >Release date: </label>
        <input asp-for="ReleaseDate" />
        <span asp-validation-for="ReleaseDate"></span>
    </div>

    <div>
        <label asp-for="Publisher">Publisher: </label>
        <input asp-for="Publisher"/>
    </div>

    <div>
        <button type="submit">Add Book</button>
    </div>
</form>