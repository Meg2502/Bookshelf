@model Bookshelf.ViewModels.CreateBookViewModel
@{
    ViewData["Title"] = "AddBook";
}

<form method="post">
    <div>
        <label> Title: </label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>

   <div>
        <label>Author:</label>
        <select asp-for="AuthorID"
                class="form-control">
                <option value="">Select Author</option>
                @foreach (var author in Model.ExistingAuthors)
                    {
                        <option option value="@author.Id">@author.Name, @author.Birthdate  </option>
                    }
                    
        </select>
        
     </div>

    <div>
        <label> Genre:</label>
        <select asp-for="SelectedGenres"
                asp-items="Html.GetEnumSelectList<BookshelfBL.Genre>()"
                    multiple
                    class="form-select">
        </select> 
    </div>
    
    <div>
        <label >Description: </label>
        <input asp-for="Description" />
        
    </div>

    <div>
        <label >Release date: </label>
        <input asp-for="ReleaseDate" />
        <span asp-validation-for="ReleaseDate"></span>
    </div>

    <div>
        <label>Publisher: </label>
        <input asp-for="Publisher"/>
    </div>

    <div>
        <button type="submit">Add Book</button>
    </div>
</form>