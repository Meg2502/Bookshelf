@model BookshelfBL.Models.BookModel
@{
    ViewData["Title"] = "AddBook";
}

<form method="post">
    <div>
        <label for="book-title">Book Title</label>
        <input asp-for="Title">
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label for="book-Author">Author</label>
        <select asp-for="AuthorId" asp-items="ViewBag.Authors"></select>
        <span asp-validation-for="AuthorId"></span>
    </div>

    <div>
        <label for="book-genre">Genre</label>
        <select asp-for="Genre" asp-items="Html.GetEnumSelectList<BookshelfBL.Models.BookModel.Genres>()"></select>
        <span asp-validation-for="Genre"></span>
    </div>

    <div>
        <label for="book-description">Description</label>
        <input asp-for="Description" />
        <span asp-validation-for="Description"></span>
    </div>

    <div>
        <label for="book-releasedate">Release date</label>
        <input asp-for="ReleaseDate" />
        <span asp-validation-for="ReleaseDate"></span>
    </div>

    <div>
        <button type="submit">Add Book</button>
    </div>
</form>