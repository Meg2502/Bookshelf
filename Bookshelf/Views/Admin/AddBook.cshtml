@model Bookshelf.Models.BookModel
@{
    ViewData["Title"] = "AddBook";
}

<form method="post">
    <div>
        <label for="book-title">Book Title</label>
        <input asp-for="Title">
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label for="book-Author">Author</label>
        <input asp-for="Author">
        <span asp-validation-for="Author"></span>
    </div>

    <div>
        <label for="book-title">Genre</label>
        <input asp-for="Genre" />
        <span asp-validation-for="Genre"></span>
    </div>

    <div>
        <label for="book-description">Description</label>
        <input asp-for="Description" />
        <span asp-validation-for="Description"></span>
    </div>

    <div>
        <label for="book-releasedate">Release date</label>
        <input asp-for="ReleaseDate" />
        <span asp-validation-for="ReleaseDate"></span>
    </div>

    <div>
        <button type="submit">Add Book</button>
    </div>
</form>